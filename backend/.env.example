# ---------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#   cp backend/.env.example backend/.env
#
# The app validates these on boot (src/config/env.js) and exits
# with a clear message if a required one is missing — better to
# fail loudly at startup than to serve traffic with a broken
# config and discover it on the first request.
# ---------------------------------------------------------------

# ---------- REQUIRED ----------

# Postgres connection string.
# Use `postgres` as the host when running via docker compose (that's the
# service name on the compose network); use `localhost` when running the
# API on your machine against the containerized database.
DATABASE_URL=postgresql://jobtrack:jobtrack_dev_password@postgres:5432/jobtrack

# Signing key for JWTs. Generate a real one — do not ship this value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# ---------- OPTIONAL (sensible defaults shown) ----------

# How long an access token stays valid (zeit/ms format: 15m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Redis, used for the dashboard cache and the BullMQ reminder queue.
REDIS_URL=redis://redis:6379

# Port the API listens on.
PORT=4000

# Allowed browser origin for CORS. Must match where the frontend is served.
CLIENT_ORIGIN=http://localhost:5173

# How many minutes before an interview the reminder email should fire.
REMINDER_LEAD_MINUTES=30

# ---------- EMAIL (optional) ----------
# If MAIL_HOST / MAIL_USER / MAIL_PASSWORD are unset, the app logs emails
# to the console instead of sending them. That keeps local development
# working with zero email setup — nothing silently fails.
# For local testing, Mailtrap or Mailhog both work well here.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=JobTrack <no-reply@jobtrack.local>
